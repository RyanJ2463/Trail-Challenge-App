# Public Mapbox access token (Account > Tokens on mapbox.com — the default
# public token works). Prefixing with EXPO_PUBLIC_ inlines it into the JS
# bundle at build time; see App.tsx.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Supabase project URL and anon (public) key — Project Settings > API on
# supabase.com once the project exists. The anon key is safe to ship in the
# client; it's meaningless without the RLS policies in supabase/migrations
# actually applied to the project. See lib/supabase.ts.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
